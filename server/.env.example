NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=wordgame
DB_PASS=wordgame
DB_NAME=wordgame
# 开发环境可显式打开；生产必须使用 migration job 并保持 false。
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=wordgame:
JWT_SECRET=replace-with-a-long-random-secret
WORD_APPLY_AUTO_MERGE_THRESHOLD=10
WORD_APPLY_DAILY_LIMIT=5
# 审核端未上线前保持 false。
WORD_APPLY_AUTO_MERGE_ENABLED=false
FAULT_INJECTION_POINTS=
